<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.examsystem.mapper.AdminMapper">

    <!-- ================================================================ -->
    <!-- 管理员（Admin）实体结果映射                                           -->
    <!-- 表：t_admin，主键：admin_id                                        -->
    <!-- ================================================================ -->
    <resultMap id="BaseResultMap" type="com.examsystem.entity.Admin">
        <id column="admin_id" property="adminId"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="phone" property="phone"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 根据用户名查询管理员，用于登录认证 -->
    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT * FROM t_admin WHERE username = #{username}
    </select>

    <!-- 根据主键 admin_id 查询管理员 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM t_admin WHERE admin_id = #{adminId}
    </select>

    <!-- 新增管理员，主键自动回填到 adminId 字段 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="adminId">
        INSERT INTO t_admin (username, password, real_name, phone, create_time)
        VALUES (#{username}, #{password}, #{realName}, #{phone}, #{createTime})
    </insert>

    <!-- 动态更新管理员信息：只更新传入的非空字段 -->
    <update id="update">
        UPDATE t_admin
        <set>
            <if test="username != null">username = #{username},</if>   <!-- 用户名 -->
            <if test="password != null">password = #{password},</if>   <!-- 密码 -->
            <if test="realName != null">real_name = #{realName},</if>  <!-- 真实姓名 -->
            <if test="phone != null">phone = #{phone},</if>            <!-- 手机号 -->
        </set>
        WHERE admin_id = #{adminId}
    </update>

    <!-- 修改管理员密码 -->
    <update id="updatePassword">
        UPDATE t_admin SET password = #{password} WHERE admin_id = #{adminId}
    </update>

</mapper>
