<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.examsystem.mapper.ExamAnswerMapper">

    <!-- ================================================================ -->
    <!-- 考试答案（ExamAnswer）实体结果映射                                     -->
    <!-- 表：t_exam_answer，主键：answer_id                                  -->
    <!-- ================================================================ -->
    <resultMap id="BaseResultMap" type="com.examsystem.entity.ExamAnswer">
        <id column="answer_id" property="answerId"/>
        <result column="exam_record_id" property="examRecordId"/>
        <result column="question_id" property="questionId"/>
        <result column="student_answer" property="studentAnswer"/>
        <result column="is_correct" property="isCorrect"/>
        <result column="score" property="score"/>
        <!-- 以下字段来自 JOIN t_question，非 t_exam_answer 表字段 -->
        <result column="question_content" property="questionContent"/>
        <result column="correct_answer" property="correctAnswer"/>
        <result column="analysis" property="analysis"/>
        <result column="question_type" property="questionType"/>
    </resultMap>

    <!-- 插入单条考试答案记录 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="answerId">
        INSERT INTO t_exam_answer (exam_record_id, question_id, student_answer, is_correct, score)
        VALUES (#{examRecordId}, #{questionId}, #{studentAnswer}, #{isCorrect}, #{score})
    </insert>

    <!-- 批量插入考试答案记录，用于交卷时一次保存所有答案 -->
    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="answerId">
        INSERT INTO t_exam_answer (exam_record_id, question_id, student_answer, is_correct, score) VALUES
        <foreach collection="list" item="item" separator=",">  <!-- 遍历答案列表，用逗号分隔多个 VALUES -->
            (#{item.examRecordId}, #{item.questionId}, #{item.studentAnswer}, #{item.isCorrect}, #{item.score})
        </foreach>
    </insert>

    <!-- 根据题目ID删除关联答案（删除题目时级联删除 FK 引用） -->
    <delete id="deleteByQuestionId">
        DELETE FROM t_exam_answer WHERE question_id = #{questionId}
    </delete>

    <!-- 根据试卷ID删除关联答案（删除试卷时级联删除 FK 引用）
         通过 JOIN 找到该试卷下所有考试记录的答案并删除 -->
    <delete id="deleteByPaperId">
        DELETE ea FROM t_exam_answer ea
        INNER JOIN t_exam_record er ON ea.exam_record_id = er.exam_record_id
        WHERE er.paper_id = #{paperId}
    </delete>

    <!-- 根据考试记录ID查询该次考试的所有答案，并关联题目表获取题目内容、正确答案和解析 -->
    <select id="selectByExamRecordId" resultMap="BaseResultMap">
        SELECT ea.*, q.content AS question_content, q.answer AS correct_answer, q.analysis, q.question_type
        FROM t_exam_answer ea
        LEFT JOIN t_question q ON ea.question_id = q.question_id
        WHERE ea.exam_record_id = #{examRecordId}
        ORDER BY ea.answer_id
    </select>

</mapper>
